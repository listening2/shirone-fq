<script>
	import { mountHomeBlinds } from "../home-blinds";
	import { mountHomeDialogue } from "../home-dialogue";

	/**
	 * 首页只剩影像层：全屏明信片收缩成首幕、横向五幕推进由 mountHomeBlinds 驱动；
	 * 左下角角色对话与返回顶部按钮由 mountHomeDialogue 接管。
	 * 移动端与减弱动效由 CSS 整层折叠为静态回退，这里不挂滚动逻辑。
	 */
	let teardown: (() => void) | null = null;

	/**
	 * 顶部个人信息卡：站名（持久壳里的标题链接）是触发器，悬停或聚焦时展开；
	 * 指针从标题移到卡片途中会短暂离开，用延迟收起避免闪断。
	 */
	function mountProfileCard(home: HTMLElement): () => void {
		const card = home.querySelector<HTMLElement>("[data-mmz-profile]");
		/* 顶栏站名链接是 #navbar 内唯一带 .group 的锚点（导航项用 top-app-bar__nav-link） */
		const trigger = document.querySelector<HTMLElement>("#navbar a.group");
		if (!card || !trigger) return () => {};

		const controller = new AbortController();
		const { signal } = controller;
		let closeTimer = 0;

		const open = () => {
			window.clearTimeout(closeTimer);
			card.dataset.open = "true";
			card.setAttribute("aria-hidden", "false");
			trigger.setAttribute("aria-expanded", "true");
		};
		const close = () => {
			window.clearTimeout(closeTimer);
			card.dataset.open = "false";
			card.setAttribute("aria-hidden", "true");
			trigger.setAttribute("aria-expanded", "false");
		};
		const scheduleClose = () => {
			window.clearTimeout(closeTimer);
			closeTimer = window.setTimeout(close, 200);
		};

		trigger.setAttribute("aria-haspopup", "true");
		trigger.setAttribute("aria-expanded", "false");
		trigger.addEventListener("mouseenter", open, { signal });
		trigger.addEventListener("focus", open, { signal });
		trigger.addEventListener("mouseleave", scheduleClose, { signal });
		trigger.addEventListener(
			"focusout",
			(event) => {
				const next = event.relatedTarget;
				if (next instanceof Node && card.contains(next)) return;
				scheduleClose();
			},
			{ signal },
		);
		card.addEventListener("mouseenter", open, { signal });
		card.addEventListener("mouseleave", scheduleClose, { signal });
		card.addEventListener("focusin", open, { signal });
		card.addEventListener(
			"focusout",
			(event) => {
				const next = event.relatedTarget;
				if (next instanceof Node && card.contains(next)) return;
				scheduleClose();
			},
			{ signal },
		);
		document.addEventListener(
			"keydown",
			(event) => {
				if (event.key === "Escape") close();
			},
			{ signal },
		);

		return () => {
			window.clearTimeout(closeTimer);
			controller.abort();
			trigger.removeAttribute("aria-haspopup");
			trigger.removeAttribute("aria-expanded");
		};
	}

	/**
	 * 相册卡片堆叠的点击视图：点任一卡片后该卡片放大成焦点图，
	 * 其余卡片缩成底部缩略图条；再次点击焦点图或按 Esc 回到扇形。
	 */
	function mountAlbumStack(home: HTMLElement): () => void {
		const stack = home.querySelector<HTMLElement>("[data-mmz-album-stack]");
		const cards = stack
			? Array.from(stack.querySelectorAll<HTMLElement>("[data-album-card]"))
			: [];
		if (!stack || cards.length < 2) return () => {};

		const controller = new AbortController();
		const { signal } = controller;
		/* 扇形几何在模板里以百分比写进 style，进入选中态前先存一份原始值 */
		for (const card of cards) {
			card.dataset.fanStyle = card.getAttribute("style") ?? "";
		}
		let active = -1;

		const apply = (
			card: HTMLElement,
			x: number,
			y: number,
			rotate: number,
			scale: number,
			z: number,
		) => {
			card.style.setProperty("--stack-x", `${x.toFixed(1)}px`);
			card.style.setProperty("--stack-y", `${y.toFixed(1)}px`);
			card.style.setProperty("--stack-r", `${rotate}deg`);
			card.style.setProperty("--stack-s", scale.toFixed(2));
			card.style.setProperty("--stack-z", String(z));
		};

		const layout = () => {
			if (active < 0) return;
			const width = stack.clientWidth;
			const cardWidth = cards[0].offsetWidth || 1;
			const focusWidth = Math.min(width * 0.46, 320);
			const focusHeight = (focusWidth * 4) / 3;
			const thumbWidth = Math.max(40, Math.min(64, width * 0.08));
			const thumbHeight = (thumbWidth * 4) / 3;
			const rowGap = 32;
			const height = focusHeight + rowGap + thumbHeight + 8;
			stack.style.height = `${height.toFixed(1)}px`;

			cards.forEach((card, index) => {
				if (index === active) {
					card.classList.add("is-active");
					apply(
						card,
						0,
						focusHeight / 2 - height / 2,
						0,
						focusWidth / cardWidth,
						60,
					);
					return;
				}
				card.classList.remove("is-active");
				const order = index < active ? index : index - 1;
				const total = cards.length - 1;
				const x = (order - (total - 1) / 2) * (thumbWidth + 10);
				apply(
					card,
					x,
					height / 2 - thumbHeight / 2,
					0,
					thumbWidth / cardWidth,
					30,
				);
			});
		};

		const collapse = () => {
			active = -1;
			stack.classList.remove("is-selected");
			stack.style.height = "";
			for (const card of cards) {
				card.classList.remove("is-active");
				card.setAttribute("style", card.dataset.fanStyle ?? "");
			}
		};

		const select = (index: number) => {
			if (index === active) {
				collapse();
				return;
			}
			active = index;
			stack.classList.add("is-selected");
			layout();
		};

		stack.addEventListener(
			"click",
			(event) => {
				const target = (event.target as HTMLElement).closest<HTMLElement>(
					"[data-album-card]",
				);
				if (!target) return;
				const index = Number(target.dataset.index);
				if (Number.isNaN(index)) return;
				select(index);
			},
			{ signal },
		);

		document.addEventListener(
			"keydown",
			(event) => {
				if (event.key === "Escape" && active >= 0) collapse();
			},
			{ signal },
		);

		window.addEventListener(
			"resize",
			() => {
				if (active >= 0) layout();
			},
			{ signal },
		);

		return () => {
			controller.abort();
		};
	}

	/** 页脚运行时长：SSR 已给出首帧文本，这里每秒按建站时间重算。 */
	function mountRuntimeClock(home: HTMLElement): () => void {
		const node = home.querySelector<HTMLElement>("[data-mmz-runtime]");
		const output = node?.querySelector<HTMLElement>("[data-mmz-runtime-text]");
		const template = node?.dataset.template;
		const since = node?.dataset.since;
		if (!node || !output || !template || !since) return () => {};

		const startedAt = new Date(since).getTime();
		if (Number.isNaN(startedAt)) return () => {};

		const render = () => {
			const elapsed = Math.max(0, Date.now() - startedAt);
			output.textContent = template.replace(/\{(\w+)\}/g, (_, key: string) => {
				const value =
					key === "days"
						? Math.floor(elapsed / 86400000)
						: key === "hours"
							? Math.floor(elapsed / 3600000) % 24
							: key === "minutes"
								? Math.floor(elapsed / 60000) % 60
								: key === "seconds"
									? Math.floor(elapsed / 1000) % 60
									: null;
				return value === null ? `{${key}}` : String(value);
			});
		};

		render();
		const timer = window.setInterval(render, 1000);
		return () => window.clearInterval(timer);
	}

	function mountHome() {
		const home = document.querySelector<HTMLElement>("[data-mmz-home]");
		if (!home || home.dataset.mmzMounted === "true") return;
		home.dataset.mmzMounted = "true";

		const dialogueRoot = home.querySelector<HTMLElement>("[data-mmz-dialogue]");
		const dialogueController = mountHomeDialogue(dialogueRoot);
		const blindsRoot = home.querySelector<HTMLElement>("[data-mmz-blinds]");
		/* Swup 换页时内容替换先于平滑滚动，此刻 scrollY 还是旧页面的值；
		   首帧必须等滚动落定（`swup:scroll:end`）再出 */
		const fromSwup = document.documentElement.dataset.swupVisiting === "true";
		const teardownBlinds = blindsRoot
			? mountHomeBlinds(blindsRoot, {
					setSceneVisible: dialogueController.setSceneVisible,
					setGreetingVisible: dialogueController.setGreetingVisible,
					deferFirstSync: fromSwup,
				})
			: null;
		const teardownProfile = mountProfileCard(home);
		const teardownRuntime = mountRuntimeClock(home);
		const teardownAlbum = mountAlbumStack(home);

		teardown = () => {
			teardownBlinds?.();
			dialogueController.destroy();
			teardownProfile();
			teardownRuntime();
			teardownAlbum();
			teardown = null;
		};
	}

	document.addEventListener("swup:visit:start", () => {
		teardown?.();
	});
	document.addEventListener("swup:page:view", mountHome);

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", mountHome, { once: true });
	} else {
		mountHome();
	}
</script>

