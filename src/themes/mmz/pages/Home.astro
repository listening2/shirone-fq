		gap: 0.4rem;
		margin: 0;
		font-family: var(--m3e-font-mono-family);
		font-size: 0.75rem;
		color: var(--on-surface-variant);
	}

	.mmz-footer__meta-row :global(svg) {
		width: 0.95rem;
		height: 0.95rem;
		color: var(--on-surface-variant);
	}

	/* ------------------------------------------------------------- 移动端 */

	.mmz-mobile {
		display: none;
	}

	.mmz-mobile-hero {
		display: flex;
		min-height: 100svh;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		padding: 4.5rem 1.25rem 5.75rem;
		text-align: center;
	}

	.mmz-mobile-hero__main {
		display: flex;
		margin-top: clamp(6.5rem, 27svh, 12rem);
		flex-direction: column;
		align-items: center;
	}

	.mmz-mobile-avatar {
		width: 7rem;
		height: 7rem;
		padding: 4px;
		border: 2px solid var(--on-surface);
		border-radius: var(--shape-corner-full);
		object-fit: cover;
		background: var(--page-bg);
	}

	.mmz-mobile-name {
		margin: 2rem 0 0;
		font-family: var(--font-sans);
		font-size: 2rem;
		font-weight: 900;
		line-height: 1.1;
		letter-spacing: 0.1em;
	}

	.mmz-mobile-role {
		margin: 0.75rem 0 0;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--on-surface-variant);
	}

	.mmz-mobile-bio {
		max-width: 21rem;
		margin: 0.9rem 0 0;
		font-family: var(--font-sans);
		font-size: 0.75rem;
		line-height: 1.7;
		color: color-mix(in oklab, var(--on-surface) 55%, transparent);
	}

	.mmz-mobile-hero__foot {
		display: grid;
		justify-items: center;
		gap: 1.25rem;
	}

	.mmz-mobile-stats {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 0.4rem;
		font-family: var(--font-sans);
	}

	.mmz-mobile-stat {
		display: inline-flex;
		align-items: baseline;
		gap: 0.3em;
		color: var(--on-surface-variant);
		font-size: 0.75rem;
		text-decoration: none;
	}

	.mmz-mobile-stat__value {
		font-family: var(--m3e-font-mono-family);
		font-size: 0.875rem;
		font-weight: 800;
		color: var(--on-surface);
	}

	.mmz-mobile-stats__sep {
		color: var(--outline);
		font-size: 0.75rem;
	}

	.mmz-mobile-social {
		display: flex;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mmz-mobile-social__link {
		display: inline-grid;
		width: 2.5rem;
		height: 2.5rem;
		place-items: center;
		border: 1px solid color-mix(in oklab, var(--on-surface) 14%, transparent);
		border-radius: var(--shape-corner-full);
		color: var(--on-surface);
	}

	.mmz-mobile-social__link :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}

	.mmz-mobile-content {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1rem 1.25rem 3rem;
	}

	/* 分区标题：行标签 + 大字 + 通栏横线 */
	.mmz-mobile-head {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		margin-top: 1rem;
	}

	.mmz-mobile-head__row {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		margin: 0;
		font-size: 0.95rem;
		font-weight: 900;
		letter-spacing: 0.14em;
	}

	.mmz-mobile-head__index {
		font-family: var(--m3e-font-mono-family);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: color-mix(in oklab, var(--on-surface) 45%, transparent);
	}

	.mmz-mobile-head__label {
		font-family: var(--font-sans);
	}

	.mmz-mobile-head__en {
		font-family: var(--font-sans);
		font-size: clamp(2.6rem, 15vw, 3.75rem);
		font-weight: 900;
		line-height: 1.08;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		overflow-wrap: anywhere;
	}

	.mmz-mobile-head__rule {
		height: 2px;
		background: var(--on-surface);
	}

	/* 置顶：静态叠放的三张卡，逐层下探 1rem */
	.mmz-mobile-deck {
		position: relative;
		height: 14rem;
		margin-bottom: 1.9rem;
	}

	.mmz-mobile-deck__card {
		position: absolute;
		inset: 0;
		z-index: calc(10 - var(--deck-index, 0));
		transform-origin: top center;
		translate: 0 calc(var(--deck-index, 0) * 1rem);
		scale: calc(1 - var(--deck-index, 0) * 0.05);
	}

	.mmz-mobile-deck__inner {
		display: flex;
		height: 100%;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.1rem 1.2rem;
		border: 2px solid var(--on-surface);
		border-radius: 1rem;
		background: var(--page-bg);
	}

	.mmz-mobile-deck__meta {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: color-mix(in oklab, var(--on-surface) 58%, transparent);
	}

	.mmz-mobile-deck__link {
		display: -webkit-box;
		overflow: hidden;
		font-family: var(--font-sans);
		font-size: 1.1rem;
		font-weight: 800;
		line-height: 1.45;
		color: inherit;
		text-decoration: none;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.mmz-mobile-deck__desc {
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.6;
		color: color-mix(in oklab, var(--on-surface) 62%, transparent);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
	}

	.mmz-mobile-timeline {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mmz-mobile-timeline__item {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0 0 1.5rem 1.75rem;
	}

	/* 左侧时间竖线 */
	.mmz-mobile-timeline__item::before {
		content: "";
		position: absolute;
		top: 0.55rem;
		bottom: -0.2rem;
		left: 0.36rem;
		width: 2px;
		background: color-mix(in oklab, var(--on-surface) 20%, transparent);
	}

	.mmz-mobile-timeline__item:last-child::before {
		bottom: auto;
		height: 1.1rem;
	}

	/* 时间线节点圆点 */
	.mmz-mobile-timeline__item::after {
		content: "";
		position: absolute;
		top: 0.5rem;
		left: 0;
		width: 0.75rem;
		height: 0.75rem;
		border: 2px solid var(--on-surface);
		border-radius: 50%;
		background: var(--page-bg);
		box-sizing: border-box;
	}

	.mmz-mobile-timeline__title {
		font-family: var(--font-sans);
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.5;
		color: inherit;
		text-decoration: none;
	}

	.mmz-mobile-timeline__category {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: color-mix(in oklab, var(--on-surface) 58%, transparent);
	}

	.mmz-mobile-timeline__date {
		font-family: var(--m3e-font-mono-family);
		font-size: 0.6875rem;
		font-weight: 600;
		color: color-mix(in oklab, var(--on-surface) 48%, transparent);
	}

	/* ---------------------------------------------- 左下角角色 + 想法气泡 */

	.mmz-dialogue {
		--mmz-dialogue-size: clamp(12rem, 13vw, 16rem);
		--mmz-dialogue-ink: oklch(0.22 0.01 300);
		--mmz-dialogue-paper: oklch(1 0 0);
		--mmz-dialogue-stroke: 0.2rem;
		--mmz-dialogue-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
		position: sticky;
		bottom: 0;
		z-index: 3;
		width: 100vw;
		height: 0;
		margin-inline: calc(50% - 50vw);
	}

	@supports (transition-timing-function: linear(0, 1)) {
		.mmz-dialogue {
			--mmz-dialogue-spring: linear(
				0,
				0.36 12%,
				0.86 26%,
				1.12 36%,
				0.98 46%,
				1.02 58%,
				0.995 74%,
				1
			);
		}
	}

	/* 角色本体：底边压在视口底边、左缘贴住视口左缘；图本身有透明留白，
	   看着就是卡在角上。JS 接管前保持隐藏，入场只翻 data 属性，过渡交给 CSS。 */
	.mmz-dialogue__anchor {
		position: absolute;
		bottom: 0;
		left: 0;
		width: var(--mmz-dialogue-size);
		aspect-ratio: 1;
		opacity: 0;
		visibility: hidden;
		translate: 0 2.4rem;
		transition:
			opacity var(--m3e-duration-long) var(--mmz-ease),
			visibility 0s linear var(--m3e-duration-long),
			translate var(--m3e-duration-long) var(--mmz-ease);
		will-change: transform, opacity;
	}

	.mmz-dialogue[data-scene-visible="true"] .mmz-dialogue__anchor {
		opacity: 1;
		visibility: visible;
		translate: 0 0;
		transition:
			opacity var(--m3e-duration-long) var(--mmz-ease),
			visibility 0s,
			translate var(--m3e-duration-long) var(--mmz-ease);
	}

	.mmz-dialogue__sticker {
		position: absolute;
		inset: 0;
		margin: 0;
		line-height: 0;
		filter: drop-shadow(0 0.5rem 0.8rem rgb(0 0 0 / 26%));
		/* 支点在底边：压下去时头顶动、脚不动，才像按在桌上的一团棉花 */
		transform-origin: 50% 100%;
		transition: translate 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.mmz-dialogue__sticker[data-pressed="true"] {
		scale: 1.07 0.9;
		transition: scale 220ms var(--mmz-dialogue-spring);
	}

	.mmz-dialogue__trigger {
		position: absolute;
		inset: 0;
		padding: 0;
		border: 0;
		border-radius: 50% 50% 0 0;
		background: transparent;
		cursor: pointer;
	}

	.mmz-dialogue__trigger:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	/* 想法气泡：粗描边白椭圆，挂在角色头顶右上方，从左下角冒出来 */
	.mmz-dialogue__bubble {
		position: absolute;
		bottom: 92%;
		left: 52%;
		z-index: 1;
		width: max-content;
		max-width: min(16rem, 42vw);
		margin: 0;
		padding: 0.95rem 1.75rem;
		border: var(--mmz-dialogue-stroke) solid var(--mmz-dialogue-ink);
		border-radius: 50%;
		background: var(--mmz-dialogue-paper);
		color: var(--mmz-dialogue-ink);
		font-size: clamp(0.88rem, 0.95vw, 1rem);
		font-weight: 800;
		line-height: 1.45;
		text-align: center;
		text-wrap: balance;
		transform-origin: 0% 100%;
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 180ms ease,
			visibility 0s linear 180ms;
	}

	.mmz-dialogue__bubble[data-open="true"] {
		opacity: 1;
		visibility: visible;
		transition: none;
	}

	/* 思考泡泡的两颗小圆点，从气泡左下角一路落向角色头顶 */
	.mmz-dialogue__bubble::before,
	.mmz-dialogue__bubble::after {
		content: "";
		position: absolute;
		border: var(--mmz-dialogue-stroke) solid var(--mmz-dialogue-ink);
		border-radius: 50%;
		background: var(--mmz-dialogue-paper);
	}

	.mmz-dialogue__bubble::before {
		top: calc(100% + 0.2rem);
		left: 0.9rem;
		width: 1rem;
		height: 0.85rem;
	}

	.mmz-dialogue__bubble::after {
		top: calc(100% + 1.25rem);
		left: 0.1rem;
		width: 0.62rem;
		height: 0.52rem;
	}

	.mmz-dialogue__sticker-image {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	/* 返回顶部：贴住对话层右下角，只在滚过首屏后出现 */
	.mmz-backtop {
		position: absolute;
		right: 1.5rem;
		bottom: 1.5rem;
		z-index: 5;
		display: grid;
		width: 2.8rem;
		height: 2.8rem;
		border: 1px solid color-mix(in oklab, var(--on-surface) 22%, transparent);
		border-radius: 50%;
		background: color-mix(in oklab, var(--page-bg) 92%, var(--on-surface));
		color: var(--on-surface);
		box-shadow: 0 0.8rem 1.6rem -0.9rem rgb(0 0 0 / 34%);
		font-size: 1.1rem;
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		place-items: center;
		transition:
			opacity var(--m3e-duration-medium) var(--mmz-ease),
			visibility 0s linear var(--m3e-duration-medium),
			translate var(--m3e-duration-medium) var(--mmz-ease);
	}

	.mmz-backtop[data-visible="true"] {
		opacity: 1;
		visibility: visible;
		transition:
			opacity var(--m3e-duration-medium) var(--mmz-ease),
			visibility 0s,
			translate var(--m3e-duration-medium) var(--mmz-ease);
	}

	.mmz-backtop:hover {
		translate: 0 -2px;
	}

	/* -------------------------------------------- 首屏文字层（固定叠加） */

	/* 文字压在彩色影像上，白字与暗色描边属于图片叠加的可读性例外，
	   与 .mmz-dialogue 的墨色/纸色一样不随主题翻转。 */
	.mmz-blinds__hero {
		position: fixed;
		inset: 0;
		z-index: 6;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--m3e-duration-long) var(--m3e-easing-standard),
			visibility 0s linear var(--m3e-duration-long);
	}

	.mmz-blinds__hero[data-visible="true"] {
		opacity: 1;
		visibility: visible;
		transition:
			opacity var(--m3e-duration-long) var(--m3e-easing-standard),
			visibility 0s;
	}

	/* 标题两侧的细白横线：只作为版式基准线，不承载信息 */
	.mmz-blinds__hero-line {
		position: absolute;
		top: 48%;
		width: min(20vw, 15rem);
		height: 1px;
		background: rgb(255 255 255 / 55%);
	}

	.mmz-blinds__hero-line[data-hero-line="left"] {
		left: 3vw;
	}

	.mmz-blinds__hero-line[data-hero-line="right"] {
		right: 8vw;
	}

	.mmz-blinds__hero-center {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(0.55rem, 1.5vh, 1.05rem);
		width: min(38vw, 60vh);
		max-width: 34rem;
		text-align: center;
		text-shadow: 0 2px 14px rgb(0 0 0 / 40%);
	}

	.mmz-blinds__hero-occupation {
		margin: 0;
		color: rgb(255 255 255 / 82%);
		font-size: clamp(0.72rem, 0.95vw, 1rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: 0.32em;
		text-indent: 0.32em;
	}

	.mmz-blinds__hero-name {
		margin: 0;
		color: #fff;
		font-size: clamp(1.9rem, 4vw, 4.4rem);
		font-weight: 900;
		line-height: 1.08;
		letter-spacing: 0.04em;
		white-space: nowrap;
		text-shadow: 0 3px 16px rgb(0 0 0 / 35%);
	}

	.mmz-blinds__hero-bio {
		margin: 0;
		max-width: 100%;
		color: rgb(255 255 255 / 88%);
		font-size: clamp(0.78rem, 1vw, 1.08rem);
		font-weight: 600;
		line-height: 1.55;
		letter-spacing: 0.14em;
	}

	/* 右缘贴边竖排列：柔和暗色渐变把白字托出画面 */
	.mmz-blinds__hero-side {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		width: 13%;
		padding: calc(40px + 2rem) 15px 40px;
		background: linear-gradient(-90deg, rgb(0 0 0 / 40%) 0%, transparent 100%);
	}

	.mmz-blinds__hero-pill {
		color: #fff;
		font-size: 0.65rem;
		font-weight: bold;
		letter-spacing: 2px;
	}

	.mmz-blinds__hero-vertical {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 15px;
	}

	.mmz-blinds__hero-v-title {
		color: #fff;
		font-size: 2.2rem;
		font-weight: 900;
		letter-spacing: 10px;
		writing-mode: vertical-rl;
		text-shadow: 0 4px 10px rgb(0 0 0 / 60%);
	}

	.mmz-blinds__hero-v-sub {
		color: rgb(255 255 255 / 50%);
		font-size: 0.7rem;
		letter-spacing: 6px;
		writing-mode: vertical-rl;
	}

	.mmz-blinds__hero-diamond {
		color: #b5893d;
		font-size: 0.7rem;
		animation: mmz-hero-pulse 2s infinite ease-in-out;
	}

	@keyframes mmz-hero-pulse {
		0%,
		100% {
			opacity: 0.3;
			transform: scale(0.9);
		}

		50% {
			opacity: 1;
			transform: scale(1.1);
		}
	}

	.mmz-blinds__hero-footer {
		text-align: center;
	}

	.mmz-blinds__hero-footer-line {
		width: 10px;
		height: 1px;
		margin: 0 auto 8px;
		background: rgb(255 255 255 / 20%);
	}

	.mmz-blinds__hero-micro {
		margin: 0;
		color: rgb(255 255 255 / 30%);
		font-size: 0.45rem;
		letter-spacing: 3px;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
	}

	/* 底部对话卡：磨砂深色玻璃，水平居中靠下 */
	.mmz-blinds__hero-speech {
		position: absolute;
		bottom: clamp(4.4rem, 8.6vh, 6.2rem);
		left: 50%;
		z-index: 2;
		width: min(34rem, 82%);
		padding: clamp(0.9rem, 1.35vw, 1.2rem) clamp(1rem, 1.55vw, 1.35rem);
		border: 2px solid #000;
		border-radius: 8px;
		background:
			linear-gradient(135deg, rgb(255 255 255 / 14%), rgb(255 255 255 / 5%)),
			rgb(8 10 12 / 44%);
		box-shadow: 0 22px 54px rgb(0 0 0 / 32%);
		color: rgb(255 255 255 / 86%);
		text-align: center;
		transform: translateX(-50%);
		transform-origin: 50% 100%;
		-webkit-backdrop-filter: blur(18px) saturate(145%);
		backdrop-filter: blur(18px) saturate(145%);
	}

	.mmz-blinds__hero-speech-zh {
		margin: 0;
		color: rgb(255 255 255 / 90%);
		font-size: clamp(1rem, 1.32vw, 1.34rem);
		font-weight: 950;
		line-height: 1;
		letter-spacing: 0.14em;
	}

	.mmz-blinds__hero-speech-en {
		margin: 0.46rem 0 0;
		color: rgb(255 255 255 / 54%);
		font-size: clamp(0.58rem, 0.76vw, 0.8rem);
		font-weight: 850;
		line-height: 1.25;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* -------------------------------------------- 双层影像：揭示 + 横向五幕 */

	.mmz-blinds {
		position: relative;
		z-index: 1;
		width: 100vw;
		margin-right: calc(50% - 50vw);
		margin-left: calc(50% - 50vw);
		isolation: isolate;
	}

	.mmz-blinds__reveal,
	.mmz-blinds__scenes {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100vh;
		min-height: 100vh;
		background: transparent;
	}

	.mmz-blinds__reveal-viewport {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 100vh;
		overflow: hidden;
		background: transparent;
	}

	.mmz-blinds__scenes-viewport {
		position: sticky;
		top: 0;
		width: 100%;
		height: 100vh;
		min-height: 100vh;
		overflow: hidden;
		background: transparent;
	}

	.mmz-blinds__stage {
		position: fixed;
		inset: 0;
		z-index: 0;
		/* 刻意不写 width / height：inset: 0 恒等于视口，
		   reveal 背景的 cover 裁切与 portal 收缩几何都以此为基准 */
		overflow: hidden;
		background: var(--page-bg);
		/* 默认就铺 reveal 图：Swup 换页时内容先于脚本落位，如果这里默认隐藏，
		   新页面会先闪一帧没有影像的空白纹理。首页顶部本来就该是这张图 */
		opacity: 1;
		visibility: visible;
		pointer-events: none;
	}

	.mmz-blinds__background {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		user-select: none;
		-webkit-user-drag: none;
	}

	.mmz-blinds__portal,
	.mmz-blinds__track {
		position: absolute;
		inset: 0;
	}

	/* 过渡层：全屏背景收缩成首幕图框。
	   收缩靠 clip-path 收窗（只触发 paint）加内部图片的等比 scale，
	   起点精确等于视口 cover、终点精确等于图框 cover。 */
	.mmz-blinds__portal {
		z-index: 5;
		overflow: hidden;
		background: var(--page-bg);
		opacity: 0;
		visibility: hidden;
		will-change: clip-path, opacity;
	}

	/* 过渡层图片不吃 inset：控制器按「视口 cover 的渲染尺寸」写显式宽高，
	   收缩全程只用等比 scale。居中交给控制器写的 translate，这里只给 top / left。 */
	.mmz-blinds__portal-image {
		position: absolute;
		top: 50%;
		left: 50%;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		user-select: none;
		-webkit-user-drag: none;
		will-change: transform;
	}

	/* ------------------------ 第二层拼图：整周期左移，单张 SVG 蒙版不逐块建 DOM */

	.mmz-blinds__cycle {
		position: absolute;
		inset: 0;
		z-index: 0;
		--mmz-cycle-period: 224px;
		--mmz-cycle-line: color-mix(in srgb, var(--on-surface) 12%, transparent);
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		transform-origin: 50% 100%;
		will-change: transform, opacity;
	}

	.mmz-blinds__cycle-track {
		position: absolute;
		top: 0;
		right: calc(-1 * var(--mmz-cycle-period));
		bottom: 0;
		left: 0;
		z-index: 0;
		background: var(--mmz-cycle-line);
		mask-image: url("../assets/blinds/puzzle.svg");
		mask-size: var(--mmz-cycle-period) var(--mmz-cycle-period);
		mask-repeat: repeat;
		will-change: transform;
	}

	/* -------------------------------- 第二层留言墙：气泡各自漂过，飘完换下一条 */

	.mmz-blinds__bubbles {
		position: absolute;
		inset: 0;
		z-index: 3;
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.mmz-blind-bubble {
		position: absolute;
		top: var(--mmz-bubble-top, 50%);
		left: 0;
		max-width: 20rem;
		will-change: transform;
		animation: mmz-bubble-drift var(--mmz-bubble-duration, 32s) linear infinite;
	}

	.mmz-blind-bubble.is-empty {
		visibility: hidden;
	}

	.mmz-blind-bubble__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45em;
		padding: 0.42rem 0.95rem 0.6rem;
		border: 1px solid color-mix(in srgb, var(--on-surface) 16%, transparent);
		border-radius: var(--shape-corner-l);
		background: color-mix(in srgb, var(--page-bg) 68%, transparent);
		color: color-mix(in srgb, var(--on-surface) 62%, transparent);
		font-size: calc(0.86rem * var(--mmz-bubble-scale, 1));
		line-height: 1.45;
	}

	.mmz-blind-bubble__image {
		display: none;
		flex: none;
		width: 9em;
		height: 6.2em;
		border-radius: var(--shape-corner-m);
		object-fit: cover;
		opacity: 0;
		background: color-mix(in srgb, var(--on-surface) 12%, transparent);
		transition: opacity 0.45s ease;
	}

	.mmz-blind-bubble__image.is-loading {
		background-image: linear-gradient(
			100deg,
			transparent 20%,
			color-mix(in srgb, var(--on-surface) 16%, transparent) 45%,
			transparent 70%
		);
		background-size: 220% 100%;
		animation: mmz-bubble-shimmer 1.25s linear infinite;
	}

	.mmz-blind-bubble__image.is-loaded {
		opacity: 1;
	}

	.mmz-blind-bubble__text {
		display: -webkit-box;
		max-width: 100%;
		overflow: hidden;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow-wrap: break-word;
		white-space: normal;
	}

	.mmz-blind-bubble.has-image .mmz-blind-bubble__image {
		display: block;
	}

	.mmz-blinds__bubbles.is-paused .mmz-blind-bubble,
	.mmz-blinds__bubbles.is-paused .mmz-blind-bubble__image {
		animation-play-state: paused;
	}

	@keyframes mmz-bubble-shimmer {
		from {
			background-position: 180% 0;
		}

		to {
			background-position: -80% 0;
		}
	}

	@keyframes mmz-bubble-drift {
		from {
			transform: translate3d(100vw, 0, 0);
		}

		to {
			transform: translate3d(-100%, 0, 0);
		}
	}

	.mmz-blinds__track {
		z-index: 2;
		pointer-events: none;
	}

	/* 第二幕起的单幕几何：尺寸与纸色由子组件继承 */
	.mmz-blinds__scenes {
		--mmz-blind-edge: 2px;
		--mmz-blind-pad: clamp(1rem, 1.9vw, 1.6rem);
		--mmz-blind-band-height: clamp(2.9rem, 5vh, 3.6rem);
		--mmz-blind-photo-width: min(
			44vw,
			52rem,
			calc(
				(
					60vh - var(--mmz-blind-pad) * 2 - var(--mmz-blind-band-height)
				) * 4 / 3
			)
		);
		--mmz-blind-photo-height: calc(var(--mmz-blind-photo-width) * 3 / 4);
		--mmz-blind-width: calc(
			var(--mmz-blind-photo-width) + var(--mmz-blind-pad) * 2 +
				var(--mmz-blind-edge) * 2
		);
		--mmz-blind-height: calc(
			var(--mmz-blind-photo-height) + var(--mmz-blind-pad) * 2 +
				var(--mmz-blind-band-height) + var(--mmz-blind-edge) * 2
		);
		/* 明信片纸面与墨色不随主题翻转，属内容型材质例外 */
		--mmz-blind-paper: #f9f3e4;
		--mmz-blind-ink: #4c4536;
		--mmz-blind-wood: oklch(from var(--mmz-blind-ink) calc(l + 0.16) 0 h);
		--mmz-blind-highlight: oklch(from var(--mmz-blind-paper) l 0 h);
		--mmz-blind-clip-height: clamp(3.4rem, 5.7vw, 5rem);
		/* 吊线长度 = 视窗顶到卡顶 + 8rem 余量；双数幕会覆盖，引用处必须现算 */
		--mmz-blind-string-length: calc(
			50vh - var(--mmz-blind-height) / 2 + 8rem
		);
		height: calc(100vh + max(3400px, 340vh));
	}

	/* ------------------------ 底部图片列表：底边贴层底，每张独立位移 */

	.mmz-blinds__stands {
		--mmz-stand-height: min(24vh, 15rem);
		--mmz-stand-width: min(24vw, 13rem);
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 5;
		height: var(--mmz-stand-height);
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.mmz-blinds__stands-track {
		position: absolute;
		inset: 0;
	}

	.mmz-blinds__stand {
		position: absolute;
		bottom: 0;
		left: 0;
		width: max-content;
		pointer-events: auto;
		touch-action: pan-y;
		cursor: grab;
		user-select: none;
		will-change: transform;
	}

	.mmz-blinds__stand.is-dragging {
		cursor: grabbing;
	}

	/* 同时限制单张宽高；内层以底边为铰链立起，不占用外层横移的 transform */
	.mmz-blinds__stand-image {
		display: block;
		width: auto;
		height: auto;
		max-width: var(--mmz-stand-width);
		max-height: var(--mmz-stand-height);
		object-fit: contain;
		object-position: center bottom;
		transform-origin: 50% 100%;
		user-select: none;
		-webkit-user-drag: none;
	}

	@supports (height: 100dvh) {
		.mmz-blinds__reveal,
		.mmz-blinds__scenes,
		.mmz-blinds__reveal-viewport,
		.mmz-blinds__scenes-viewport {
			height: 100dvh;
			min-height: 100dvh;
		}

		.mmz-blinds__stands {
			--mmz-stand-height: min(24dvh, 15rem);
		}
	}

	/* -------------------------------------------- 终幕放大与内容区 */

	/* 终幕放大层：最后一幕从图框扩到满屏。恒为 fixed，必须挂在根层级，
	   被 pin 的场景 section 残留 transform 会把 fixed 退化成相对 section 定位。
	   z 序：stage(0) < 终幕层(1) < 内容区(2) < 终幕文字层(3)。 */
	.mmz-blinds__finale {
		position: fixed;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		background: var(--page-bg);
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		will-change: clip-path, opacity, filter;
	}

	/* 图片初始按满屏 cover 撑住；就绪后控制器按自然尺寸写显式宽高，
	   放大全程只用等比例 scale。 */
	.mmz-blinds__finale-image {
		position: absolute;
		top: 50%;
		left: 50%;
		display: block;
		width: 100vw;
		height: 100vh;
		object-fit: cover;
		object-position: center;
		user-select: none;
		-webkit-user-drag: none;
		will-change: transform, opacity, filter;
	}

	/* 终幕文字层：独立 fixed 层，盖在内容区之上；每帧由控制器按内容区
	   顶缘实测写入位置，与「快速带你前往」同层同速上滑。 */
	.mmz-finale-copy {
		position: fixed;
		inset: 0;
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1.5rem;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		will-change: opacity, transform;
	}

	/* 白字与暗色描边属终幕图片上的可读性例外 */
	.mmz-finale-copy__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		color: #fff;
		text-align: center;
		text-shadow: 0 2px 12px rgb(0 0 0 / 48%);
	}

	.mmz-finale-copy__title {
		margin: 0;
		font-size: clamp(2.5rem, 6vw, 4.75rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: 0.04em;
	}

	.mmz-finale-copy__subtitle {
		margin: 0.9rem 0 0;
		font-size: clamp(0.9rem, 1.4vw, 1.25rem);
		font-weight: 500;
		letter-spacing: 0.14em;
	}

	/* 终幕衔接占位：SSR 高度为 0，滚动时由控制器实测写入像素高度 */
	.mmz-finale-spacer {
		height: 0;
	}

	/* 内容区：无背景板，文字直接浮在终幕图模糊漂白后的页面上 */
	.mmz-afterglow {
		position: relative;
		z-index: 2;
		width: 100%;
		padding-block: 4.5rem 6rem;
	}

	.mmz-afterglow__inner {
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
		padding-inline: clamp(1rem, 3vw, 1.75rem);
	}

	.mmz-afterglow__compass {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.mmz-afterglow__head {
		text-align: center;
	}

	.mmz-afterglow__title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(1.25rem, 1.8vw, 1.5rem);
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--on-surface);
	}

	.mmz-afterglow__subtitle {
		margin: 0.45rem 0 0;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		color: var(--on-surface-variant);
	}

	.mmz-afterglow__nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem 1rem;
		width: min(100%, 56rem);
		margin-top: 2rem;
	}

	.mmz-afterglow__link {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.65rem;
		width: 100%;
		max-width: 10rem;
		min-width: 6.5rem;
		padding: 0.75rem 1rem;
		border: 1px solid transparent;
		border-radius: var(--shape-corner-l);
		color: var(--on-surface-variant);
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		text-decoration: none;
		overflow: hidden;
		transition:
			color var(--m3e-duration-short) var(--m3e-easing-standard),
			border-color var(--m3e-duration-short) var(--m3e-easing-standard),
			translate var(--m3e-duration-short) var(--m3e-easing-standard);
	}

	.mmz-afterglow__link:hover {
		border-color: var(--outline-variant);
		color: var(--on-surface);
		translate: 0 -2px;
	}

	.mmz-afterglow__link :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
		flex: none;
		color: var(--on-surface);
	}

	.mmz-afterglow__notice {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: min(100%, 56rem);
		margin: 2.5rem auto 0;
		padding: 0.9rem 1.25rem;
		border: 1px dashed color-mix(in oklab, var(--on-surface) 26%, transparent);
		border-radius: var(--shape-corner-l);
		color: var(--on-surface-variant);
		font-family: var(--font-sans);
		font-size: 0.85rem;
		line-height: 1.6;
	}

	.mmz-afterglow__notice-icon {
		flex: none;
		width: 1.1rem;
		height: 1.1rem;
		color: var(--on-surface);
	}

	.mmz-afterglow__notice-text {
		margin: 0;
		min-width: 0;
	}

	.mmz-afterglow__notice-link {
		flex: none;
		color: var(--on-surface);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.mmz-afterglow__columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.75rem;
		margin-top: 2.25rem;
		align-items: stretch;
	}

	/* ------------------------------------------------ 首页相册卡片堆叠 */

	/* 中间卡片压在最上层，两侧按索引外扩并轻微旋转；
	   悬停只做视觉抬起，导航由「查看相册」承担 */
	.mmz-album {
		margin-top: 3.5rem;
	}

	.mmz-album__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.mmz-album__intro {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.4rem;
	}

	.mmz-album__eyebrow {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in oklab, var(--on-surface) 55%, transparent);
	}

	.mmz-album__title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(1.35rem, 2vw, 1.75rem);
		font-weight: 800;
		letter-spacing: 0.02em;
		color: var(--on-surface);
	}

	.mmz-album__desc {
		max-width: 34rem;
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--on-surface-variant);
	}

	.mmz-album__more {
		display: inline-flex;
		align-items: center;
		flex: none;
		gap: 0.3rem;
		padding-bottom: 0.2rem;
		border-bottom: 1px solid
			color-mix(in oklab, var(--on-surface) 35%, transparent);
		color: var(--on-surface);
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			color var(--m3e-duration-short) var(--m3e-easing-standard),
			border-color var(--m3e-duration-short) var(--m3e-easing-standard);
	}

	.mmz-album__more:hover {
		border-color: var(--primary);
		color: var(--primary);
	}

	.mmz-album__more :global(svg) {
		width: 0.95rem;
		height: 0.95rem;
	}

	.mmz-album__stack {
		position: relative;
		height: clamp(15rem, 23vw, 19.5rem);
		margin-top: 2rem;
		transition: height var(--m3e-duration-medium)
			var(--m3e-easing-emphasized-decelerate);
	}

	.mmz-album__card {
		position: absolute;
		top: 50%;
		left: 50%;
		width: clamp(9.5rem, 17vw, 13rem);
		aspect-ratio: 3 / 4;
		padding: 0;
		overflow: hidden;
		border: 1px solid color-mix(in oklab, var(--on-surface) 12%, transparent);
		border-radius: var(--shape-corner-l);
		background: var(--surface-container);
		box-shadow: var(--m3e-elevation-2);
		appearance: none;
		cursor: pointer;
		font: inherit;
		color: inherit;
		z-index: var(--stack-z, 1);
		transform: translate(
				calc(-50% + var(--stack-x, 0rem)),
				calc(-50% + var(--stack-y, 0rem))
			)
			rotate(var(--stack-r, 0deg)) scale(var(--stack-s, 1));
		transition:
			transform var(--m3e-duration-medium) var(--m3e-easing-standard),
			box-shadow var(--m3e-duration-medium) var(--m3e-easing-standard);
	}

	.mmz-album__card:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}

	.mmz-album__card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 悬停：抬起当前卡片、放大并把旋转归正，底部浮出标题——与参考组件的交互一致 */
	.mmz-album__card:hover {
		z-index: 50;
		box-shadow: var(--m3e-elevation-4);
		transform: translate(
				calc(-50% + var(--stack-x, 0rem)),
				calc(-50% + var(--stack-y, 0rem) - 1.6rem)
			)
			rotate(0deg) scale(calc(var(--stack-s, 1) + 0.14));
	}

	.mmz-album__caption {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		padding: 2.2rem 0.9rem 0.75rem;
		background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
		color: #fff;
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		opacity: 0;
		transform: translateY(0.4rem);
		transition:
			opacity var(--m3e-duration-medium) var(--m3e-easing-standard),
			transform var(--m3e-duration-medium) var(--m3e-easing-standard);
	}

	.mmz-album__card:hover .mmz-album__caption {
		opacity: 1;
		transform: translateY(0);
	}

	/* 点击选中：被点的卡片放大成焦点图，其余缩成底部缩略图条；
	   选中态里悬停不再抬起，避免把缩略图从条带上扯出来 */
	.mmz-album__stack.is-selected .mmz-album__card:hover {
		box-shadow: var(--m3e-elevation-2);
		transform: translate(
				calc(-50% + var(--stack-x, 0rem)),
				calc(-50% + var(--stack-y, 0rem))
			)
			rotate(var(--stack-r, 0deg)) scale(var(--stack-s, 1));
	}

	.mmz-album__stack.is-selected .mmz-album__card.is-active {
		box-shadow: var(--m3e-elevation-4);
	}

	.mmz-album__stack.is-selected .mmz-album__card.is-active .mmz-album__caption {
		opacity: 1;
		transform: translateY(0);
	}

	.mmz-album__stack.is-selected
		.mmz-album__card:not(.is-active)
		.mmz-album__caption {
		opacity: 0;
	}

	.mmz-afterglow__col-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.mmz-afterglow__col-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--on-surface);
	}

	.mmz-afterglow__more {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--on-surface-variant);
		font-size: 0.78rem;
		text-decoration: none;
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard);
	}

	.mmz-afterglow__more:hover {
		color: var(--on-surface);
	}

	.mmz-afterglow__more :global(svg) {
		width: 0.9rem;
		height: 0.9rem;
	}

	/* 两列在栅格里等高拉伸：标题行占位固定，面板吃掉剩余高度，
	   左右两张面板无论内容多少都收在同一条底边 */
	.mmz-afterglow__col {
		display: flex;
		min-width: 0;
		flex-direction: column;
	}

	/* 面板：细描边、无底色（与公告/导览等块保持同一层平面），
	   内部独立滚动，避免首页被长列表拉长 */
	.mmz-afterglow__panel {
		display: flex;
		flex: 1;
		min-height: 0;
		flex-direction: column;
		margin-top: 0.9rem;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--outline-variant);
		border-radius: var(--shape-corner-l);
	}

	.mmz-afterglow__list,
	.mmz-afterglow__timeline {
		flex: 1;
		min-height: 0;
		max-height: 25rem;
		margin: 0;
		padding: 0;
		overflow-y: auto;
		scrollbar-width: thin;
		list-style: none;
	}

	.mmz-afterglow__post-link {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.7rem 0.5rem;
		border-radius: var(--shape-corner-m);
		color: inherit;
		text-decoration: none;
		transition: background-color var(--m3e-duration-short)
			var(--m3e-easing-standard);
	}

	.mmz-afterglow__post-link:hover {
		background: color-mix(in oklab, var(--surface-container) 60%, transparent);
	}

	.mmz-afterglow__post + .mmz-afterglow__post {
		border-top: 1px solid color-mix(in oklab, var(--outline-variant) 60%, transparent);
	}

	.mmz-afterglow__index {
		flex: none;
		width: 1.6rem;
		font-family: var(--m3e-font-mono-family);
		font-size: 0.78rem;
		font-weight: 700;
		color: color-mix(in oklab, var(--on-surface) 45%, transparent);
	}

	.mmz-afterglow__thumb {
		display: block;
		width: 3.2rem;
		height: 2.2rem;
		flex: none;
		border-radius: var(--shape-corner-s);
		object-fit: cover;
		background: var(--surface-container);
	}

	.mmz-afterglow__post-body {
		display: flex;
		flex: 1;
		min-width: 0;
		flex-direction: column;
		gap: 0.2rem;
	}

	.mmz-afterglow__post-title {
		overflow: hidden;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--on-surface);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.mmz-afterglow__post-meta {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		min-width: 0;
		font-size: 0.72rem;
		color: var(--on-surface-variant);
	}

	.mmz-afterglow__post-meta time {
		flex: none;
		font-family: var(--m3e-font-mono-family);
	}

	.mmz-afterglow__post-desc {
		overflow: hidden;
		min-width: 0;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.mmz-afterglow__category {
		flex: none;
		padding: 0.1rem 0.55rem;
		border: 1px solid var(--outline-variant);
		border-radius: var(--shape-corner-full);
		color: var(--on-surface-variant);
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.mmz-afterglow__moment {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.2rem 0.6rem;
		padding: 0.85rem 0.35rem 0.85rem 1.5rem;
	}

	/* 时间线竖线与节点圆点 */
	.mmz-afterglow__moment::before {
		content: "";
		position: absolute;
		top: 1.35rem;
		bottom: 0;
		left: 0.6rem;
		width: 2px;
		background: color-mix(in oklab, var(--on-surface) 16%, transparent);
	}

	.mmz-afterglow__moment:last-child::before {
		bottom: auto;
		height: 0.9rem;
	}

	.mmz-afterglow__dot {
		position: absolute;
		top: 1.05rem;
		left: 0.28rem;
		width: 0.65rem;
		height: 0.65rem;
		border: 2px solid var(--on-surface);
		border-radius: 50%;
		background: var(--card-bg);
		box-sizing: border-box;
	}

	.mmz-afterglow__moment[data-pinned="true"] .mmz-afterglow__dot {
		background: var(--on-surface);
	}

	.mmz-afterglow__moment-text {
		display: -webkit-box;
		flex: 1 1 12rem;
		overflow: hidden;
		min-width: 0;
		font-family: var(--font-sans);
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--on-surface);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.mmz-afterglow__moment-date {
		margin-left: auto;
		font-family: var(--m3e-font-mono-family);
		font-size: 0.7rem;
		color: var(--on-surface-variant);
	}

	.mmz-afterglow__panel .mmz-card__empty {
		padding: 1.5rem 0.5rem;
	}

	/* 减弱动效：首屏明信片落成静态图，不再挂收缩与横滑 */
	@media (prefers-reduced-motion: reduce) {
		.mmz-blinds {
			height: 100svh;
		}

		.mmz-blinds__stage {
			position: relative;
			width: 100%;
			height: 100svh;
			opacity: 1;
			visibility: visible;
		}

		.mmz-blinds__background {
			opacity: 1;
			visibility: visible;
		}

		/* 静态回退：文字层随页面滚走而不是钉在视口上，终幕与衔接占位不存在 */
		.mmz-blinds__hero {
			position: absolute;
		}

		.mmz-blinds__reveal,
		.mmz-blinds__scenes,
		.mmz-blinds__finale,
		.mmz-finale-copy,
		.mmz-finale-spacer,
		.mmz-dialogue {
			display: none;
		}

		/* 悬浮卡只保留展开/收起，不再做位移过渡 */
		.mmz-profile,
		.mmz-profile[data-open="true"] {
			transition: none;
			transform: none;
		}

		/* 相册卡片不做抬起过渡 */
		.mmz-album__card,
		.mmz-album__card:hover {
			transition: none;
		}
	}

	/* 窄屏内容区：双栏折成单栏 */
	@media (max-width: 1023.98px) {
		.mmz-afterglow__columns {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* --------------------------------------------------------------- 断点 */

	@media (max-width: 767.98px) {
		/* 桌面影像层整段不占位：移动端由两屏版式接管 */
		.mmz-blinds,
		.mmz-dialogue,
		.mmz-blinds__finale,
		.mmz-finale-copy,
		.mmz-finale-spacer,
		.mmz-afterglow {
			display: none;
		}

		.mmz-mobile {
			display: block;
		}

		/* 移动端没有顶栏标题的悬停行为，个人信息卡整层不参与排版 */
		.mmz-profile {
			display: none;
		}

		/* 页脚折成单列：品牌与联系方式左对齐，备案与运行信息自上而下 */
		.mmz-footer__top,
		.mmz-footer__bottom {
			flex-direction: column;
			align-items: flex-start;
		}

		.mmz-footer__contact {
			width: 100%;
			align-items: flex-start;
		}

		.mmz-footer__links {
			justify-content: flex-start;
		}

		.mmz-footer__meta {
			align-items: flex-start;
		}
	}

</style>

<style is:global>
	/* 首页影像层是 fixed 全屏层。Swup 的入场动画与 onload-animation 会给
	   #swup-container / #content-wrapper 加 transform，而 transform 会把
	   fixed 子元素改成相对该容器定位，首帧就闪出一张错位、缩小的大图。
	   首页不参与这两段入场动画，影像层从第一帧起就贴住视口。 */
	html.is-changing main#swup-container[data-current-page="home"],
	html.is-animating main#swup-container[data-current-page="home"],
	main#swup-container[data-current-page="home"],
	main#swup-container[data-current-page="home"] #content-wrapper {
		transition: none;
		animation: none;
		opacity: 1;
		transform: none;
	}
</style>

