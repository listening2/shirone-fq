---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { resolveAsset } from "@utils/asset-utils";
import { isPageAvailable } from "@utils/page-availability";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import {
	announcementConfig,
	LinkPresets,
	profileConfig,
	siteConfig,
} from "@/config";
import type { NavBarLink } from "@/types/navBarConfig";
import packageMetadata from "../../../../package.json";
import type { ThemeHomeData } from "../../types";
import dialogueSoundSrc from "../assets/dialogue/meow.mp3?url";
import BlindsScene from "../components/BlindsScene.astro";

/**
 * Mmz 风格首页变体：全屏明信片收缩 + 横向五幕。
 *
 * 桌面端首页只有影像层：首屏是一张全屏彩色明信片，向下滚动收进首幕图框，
 * 随后横向推进五幕（拼图底纹、气泡墙与 GIF 立绘），最后一幕停住后再滚出。
 * 左下角角色对话在首屏与收缩段贴在视口底边，进入横滑后收起。
 * 移动端（≤768px）改为两屏：个人信息 + 置顶卡 + 最新时间线。
 */
interface Props {
	data: ThemeHomeData;
}

const { data } = Astro.props;

const name = profileConfig.name;
const subtitle = siteConfig.subtitle;
const bio = profileConfig.bio;
const links = profileConfig.links;
const displayName = profileConfig.displayName ?? name;
const occupation = profileConfig.occupation;
const hero = profileConfig.homeHero;

/* 首屏右栏 / 底部对话卡：任一字段存在才渲染整层，全缺省时零 DOM 负担 */
const hasHeroAside = Boolean(
	hero?.pillText ||
		hero?.verticalTitle ||
		hero?.verticalCreative ||
		hero?.footerText ||
		hero?.speechChinese ||
		hero?.speechEnglish,
);

/* 终幕：放大到底后居中显示的文案 */
const finaleTitle = hero?.finaleTitle;
const finaleSubtitle = hero?.finaleSubtitle;

/* 「快速带你前往」：按页面可用性过滤，关闭的页面自动消失；
   同时收窄 url，供模板直接拼绝对路径 */
const quickLinks = [
	LinkPresets.Archive,
	LinkPresets.Categories,
	LinkPresets.Tags,
	LinkPresets.Moments,
	LinkPresets.Projects,
	LinkPresets.Albums,
	LinkPresets.Anime,
	LinkPresets.Timeline,
	LinkPresets.Sponsor,
	LinkPresets.Friends,
	LinkPresets.Guestbook,
	LinkPresets.About,
	LinkPresets.Skills,
	LinkPresets.Devices,
	LinkPresets.Compass,
].filter(
	(link): link is NavBarLink & { url: string } =>
		Boolean(link.url) && isPageAvailable(link.pageKey ?? "home"),
);

/* 「更多」入口：预设自身一定带 url，缺失时回退到该页固定路由 */
const archiveHref = url(LinkPresets.Archive.url ?? "/archive/");
const momentsHref = url(LinkPresets.Moments.url ?? "/moments/");

const avatarUrl = await resolveAsset(profileConfig.avatar ?? "");

// 牌堆：置顶优先，不足时用最近文章补齐
const pinnedUrls = new Set(data.pinned.map((post) => post.url));
const freshPosts = data.recent.filter((post) => !pinnedUrls.has(post.url));

/* 内容区：近期文章置顶优先，一次载入 12 条；面板首屏露出约 6 条，
   其余的在面板内向下滚动，和右侧动态时间线同一套交互 */
const afterglowPosts = [...data.pinned, ...freshPosts].slice(0, 12);
const momentItems = data.moments ?? [];
const noticeText = announcementConfig.content.trim();
const noticeLinkConfig = announcementConfig.link;
const noticeLink =
	noticeText &&
	noticeLinkConfig?.enable &&
	noticeLinkConfig.text &&
	noticeLinkConfig.url
		? noticeLinkConfig
		: null;
// 移动端叠放卡最多 3 张，层数再多下探量会挤成一条
const mobileDeckItems = [...data.pinned, ...freshPosts].slice(0, 3);
const timeline = data.recent.slice(0, 6);

/* 气泡取摘要的第一个分句，读起来像一句留言，而不是标签清单 */
const bubbleLine = (text: string, limit = 22) => {
	const clause =
		text.replace(/\s+/g, " ").split(/[，。；：!?！？,.;:]/)[0] ?? text;
	const clean = clause.trim();
	return clean.length > limit ? `${clean.slice(0, limit)}…` : clean;
};

// 影像层素材：全屏揭示背景、后四幕插画、两张 GIF 立绘、角色贴纸
const blindsRevealSrc = await resolveAsset(
	"themes/mmz/assets/blinds/reveal.webp",
);
const blindSceneSrcs = await Promise.all(
	["scene-1", "scene-2", "scene-3", "scene-4"].map((name) =>
		resolveAsset(`themes/mmz/assets/blinds/${name}.webp`),
	),
);
const standSrcs = await Promise.all(
	["stand-1", "stand-2"].map((name) =>
		resolveAsset(`themes/mmz/assets/blinds/${name}.gif`),
	),
);
const dollSrc = await resolveAsset("themes/mmz/assets/blinds/doll.avif");
/* ---------------- 悬浮个人卡与首页页脚 ---------------- */

/* 社交图标一分为二：前四个放在名片卡主行，其余收进「其他站点」 */
const primaryLinks = links.slice(0, 4);
const otherSiteLinks = links.slice(4);

/* 12 个月 × 5 格热力图：按每月第 1/8/15/22/29 天起分段统计发文量，
   再按窗口内峰值量化成 4 档（0 表示当月该段无发文） */
const heatmapMonths = (() => {
	const now = new Date();
	const locale = siteConfig.lang.replaceAll("_", "-");
	const postDates = data.postDates ?? [];
	const months = Array.from({ length: 12 }, (_, index) => {
		const cursor = new Date(now.getFullYear(), now.getMonth() - 11 + index, 1);
		const year = cursor.getFullYear();
		const month = cursor.getMonth();
		const counts = Array.from({ length: 5 }, () => 0);
		for (const iso of postDates) {
			const date = new Date(`${iso}T00:00:00`);
			if (Number.isNaN(date.getTime())) continue;
			if (date.getFullYear() !== year || date.getMonth() !== month) continue;
			counts[Math.min(4, Math.floor((date.getDate() - 1) / 7))] += 1;
		}
		return {
			label: new Intl.DateTimeFormat(locale, { month: "short" }).format(cursor),
			counts,
		};
	});
	const peak = Math.max(1, ...months.flatMap((item) => item.counts));
	return months.map((item) => ({
		label: item.label,
		cells: item.counts.map((count) =>
			count === 0 ? 0 : Math.min(3, Math.ceil((count / peak) * 3)),
		),
	}));
})();

/* 页脚：备案与自定义链接全部可选，缺省项不输出任何 DOM */
const footerOptions = profileConfig.homeFooter;
const footerBrand = footerOptions?.brand ?? name;
const footerLogo = footerOptions?.logo
	? await resolveAsset(footerOptions.logo)
	: null;
const footerTagline = footerOptions?.tagline ?? bio;

const isExternalHref = (href: string) => /^(?:https?:)?\/\//i.test(href);
const footerLinks = [
	{ label: "RSS", href: url("rss/"), external: false },
	{ label: "Atom", href: url("atom/"), external: false },
	{ label: "Sitemap", href: url("sitemap-index.xml"), external: true },
	...(footerOptions?.links ?? []).map((link) => {
		const external = isExternalHref(link.url);
		return {
			label: link.label,
			href: external ? link.url : url(link.url),
			external,
		};
	}),
];

const fillTemplate = (
	template: string,
	vars: Record<string, string | number>,
) =>
	template.replace(/\{(\w+)\}/g, (_, key: string) => String(vars[key] ?? ""));

/* 运行时长：建站日期优先取配置，其次退到最早文章日期；两者都没有则整行省略 */
const earliestPostDate = data.postDates?.length
	? [...data.postDates].sort()[0]
	: undefined;
const runtimeSince = footerOptions?.since || earliestPostDate;
const runtimeStartedAt = runtimeSince
	? new Date(`${runtimeSince}T00:00:00`).getTime()
	: null;
const nowTime = Date.now();
const runtimeElapsed =
	runtimeStartedAt && !Number.isNaN(runtimeStartedAt)
		? Math.max(0, nowTime - runtimeStartedAt)
		: null;
const runtimeLabel =
	runtimeElapsed === null
		? null
		: fillTemplate(i18n(I18nKey.mmzFooterRuntime), {
				days: Math.floor(runtimeElapsed / 86400000),
				hours: Math.floor(runtimeElapsed / 3600000) % 24,
				minutes: Math.floor(runtimeElapsed / 60000) % 60,
				seconds: Math.floor(runtimeElapsed / 1000) % 60,
			});

/* 最近更新距今天数：来自全站最新文章日期 */
const lastUpdatedAt = data.latest?.date
	? new Date(`${data.latest.date}T00:00:00`).getTime()
	: null;
const lastUpdatedDays =
	lastUpdatedAt && !Number.isNaN(lastUpdatedAt)
		? Math.max(0, Math.floor((nowTime - lastUpdatedAt) / 86400000))
		: null;
const lastUpdatedLabel =
	lastUpdatedDays === null
		? null
		: fillTemplate(i18n(I18nKey.mmzFooterUpdated), { days: lastUpdatedDays });

const creditLabel = fillTemplate(i18n(I18nKey.mmzFooterCredit), {
	year: new Date().getFullYear(),
	name: footerBrand,
});

/* 归属行：框架 / 主题与版本号同一行，分隔符与版权行保持一致的排版节奏 */
const poweredLabel = fillTemplate(i18n(I18nKey.mmzFooterPowered), {
	framework: "Astro",
	theme: "Shirone",
});
const versionLabel = `${i18n(I18nKey.siteInfoVersion)} ${packageMetadata.version}`;

/* 相册卡片堆叠：对齐参考组件 hero-card-stack 的扇形——中间卡片最大且压在最上层，
   两侧逐级缩小、外扩并递增旋转；几何量在这里算好，模板只负责写自定义属性 */
const album = data.album;
const albumHref = album ? url(`albums/${album.id}/`) : "";
const albumCards = album
	? album.photos.map((photo, index) => {
			const center = (album.photos.length - 1) / 2;
			const offset = index - center;
			/* 位移用百分比（相对卡片自身宽高），卡片随视口缩放时扇形比例不变 */
			return {
				src: photo.src,
				x: `${(offset * 58).toFixed(1)}%`,
				y: `${(Math.abs(offset) * 3.6).toFixed(1)}%`,
				rotate: `${(offset * 4.67).toFixed(1)}deg`,
				scale: (1 - Math.abs(offset) * 0.05).toFixed(2),
				z: Math.round(20 - Math.abs(offset) * 2),
			};
		})
	: [];
const albumStackLabel = album
	? fillTemplate(i18n(I18nKey.mmzAlbumStackAria), { title: album.title })
	: "";

const headlineMessages = [
	i18n(I18nKey.mmzBlindsMessage1),
	i18n(I18nKey.mmzBlindsMessage2),
	i18n(I18nKey.mmzBlindsMessage3),
	i18n(I18nKey.mmzBlindsMessage4),
];

/* 五幕：第 1 幕由固定舞台背景合成，后四幕用参考插画 + 站内文章标题/日期/摘要 */
const scenePosts = [...data.pinned, ...freshPosts].slice(0, 4);
const blindScenes = Array.from({ length: 5 }, (_, index) => {
	const post = scenePosts[index - 1];
	const fallback = index === 0 ? i18n(I18nKey.mmzBlindsHeadline) : "";
	return {
		index,
		composite: index === 0,
		image: index === 0 ? blindsRevealSrc : blindSceneSrcs[index - 1],
		alt: post?.title ?? fallback,
		title:
			post?.title ?? (index === 0 ? fallback : headlineMessages[index - 1]),
		date: post ? post.date.replaceAll("-", "/") : "",
		description: post?.description ?? post?.title ?? "",
	};
});

/* 气泡池：文章摘要/标题去重；不足时用祝福语兜底；带封面的条目附一张图 */
const bubbleSource = [...data.pinned, ...data.recent].filter(
	(post, index, list) =>
		list.findIndex((item) => item.url === post.url) === index,
);
const bubbleSeen = new Set<string>();
const bubbleMessages: string[] = [];
for (const post of bubbleSource) {
	const text = bubbleLine(post.description ?? post.title, 24);
	if (!text || bubbleSeen.has(text)) continue;
	bubbleSeen.add(text);
	bubbleMessages.push(text);
}
while (bubbleMessages.length < 12) {
	bubbleMessages.push(headlineMessages[bubbleMessages.length % 4]);
}
const bubbleImages = bubbleSource
	.map((post) => post.cover?.src)
	.filter((src): src is string => Boolean(src))
	.slice(0, 4);

/* 角色台词：优先摘要，其次标题；空站点回退副标题/自述，绝不硬编码 */
const dialogueSeen = new Set<string>();
const dialogueLines = [
	...bubbleSource.map((post) => post.description ?? post.title),
	subtitle,
	bio ?? "",
]
	.map((text) => bubbleLine(text, 48))
	.filter((text) => {
		if (!text || dialogueSeen.has(text)) return false;
		dialogueSeen.add(text);
		return true;
	})
	.slice(0, 8);

const blindsRuntime = {
	scenes: {
		scrollDistance: 3400,
		cycleDuration: 2.4,
		sceneCount: blindScenes.length,
		bubbleMessages,
		bubbleImages,
	},
};

const compact = (value: number) =>
	new Intl.NumberFormat("en-US", {
		notation: "compact",
		maximumFractionDigits: 1,
	}).format(value);
---

<div class="mmz-home" data-mmz-home>

	{/* 顶部左上角个人信息卡：悬停 / 聚焦站名时展开，离开后延迟收起。
	    固定层，挂在根节点而非影像层内，避免被 pin 段的 transform 影响。 */}
	<div
		class="mmz-profile"
		data-mmz-profile
		data-open="false"
		aria-hidden="true"
		aria-label={i18n(I18nKey.mmzProfileAria)}
	>
		<div class="mmz-profile__card" data-mmz-profile-card>
			<div class="mmz-profile__banner">
				<img
					src={blindsRevealSrc}
					alt=""
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="mmz-profile__identity">
				{avatarUrl && (
					<img
						class="mmz-profile__avatar"
						src={avatarUrl}
						alt={name}
						width="96"
						height="96"
						loading="lazy"
						decoding="async"
					/>
				)}
				<p class="mmz-profile__name">{name}</p>
				{occupation && <p class="mmz-profile__role">{occupation}</p>}
			</div>
			{primaryLinks.length > 0 && (
				<ul class="mmz-profile__social" aria-label={i18n(I18nKey.aboutSocialAria)}>
					{primaryLinks.map((link) => (
						<li>
							<a
								href={link.url}
								title={link.name}
								aria-label={link.name}
								target={isExternalHref(link.url) ? "_blank" : undefined}
								rel={isExternalHref(link.url) ? "me noopener" : "me"}
							>
								<Icon name={link.icon} />
							</a>
						</li>
					))}
				</ul>
			)}
			<div
				class="mmz-profile__heatmap"
				role="img"
				aria-label={i18n(I18nKey.mmzProfileHeatmapAria)}
			>
				{heatmapMonths.map((month) => (
					<div class="mmz-profile__month">
						<span class="mmz-profile__month-label">{month.label}</span>
						<div class="mmz-profile__cells">
							{month.cells.map((level) => (
								<span class="mmz-profile__cell" data-level={level} />
							))}
						</div>
					</div>
				))}
			</div>
			{otherSiteLinks.length > 0 && (
				<div class="mmz-profile__sites">
					<span class="mmz-profile__sites-label">
						{i18n(I18nKey.mmzOtherSites)}
					</span>
					<ul class="mmz-profile__sites-list">
						{otherSiteLinks.map((link) => (
							<li>
								<a
									href={link.url}
									title={link.name}
									aria-label={link.name}
									target={isExternalHref(link.url) ? "_blank" : undefined}
									rel={isExternalHref(link.url) ? "me noopener" : "me"}
								>
									<Icon name={link.icon} />
								</a>
							</li>
						))}
					</ul>
					<span class="mmz-profile__sites-more" aria-hidden="true">
						<Icon name="material-symbols:keyboard-arrow-down-rounded" />
					</span>
				</div>
			)}
		</div>
	</div>

	<section
		class="mmz-blinds"
		id="mmz-blinds"
		data-mmz-blinds
		aria-label={i18n(I18nKey.mmzBlindsScenesAria)}
	>
		<div class="mmz-blinds__stage" data-blinds-stage aria-hidden="true">
			<img
				class="mmz-blinds__background"
				src={blindsRevealSrc}
				alt=""
				decoding="async"
				data-blinds-background
			/>

			<!-- 全屏背景收缩成首幕画面的过渡层：clip-path 收窗 + 图片等比 scale -->
			<div class="mmz-blinds__portal" data-scenes-portal>
				<img
					class="mmz-blinds__portal-image"
					src={blindsRevealSrc}
					alt=""
					decoding="async"
					data-scenes-portal-image
				/>
			</div>
		</div>

		{/* 首屏文字层：中央职业 / 大标题 / 签名，右缘竖排列与底部对话卡。
		    固定在视口上，只随 reveal 阶段显示；进入收缩段后整层淡出。
		    颜色与描边是图片叠加的可读性例外，由 CSS 中的注释标注。 */}
		<div class="mmz-blinds__hero" data-blinds-hero data-visible="true">
			<span class="mmz-blinds__hero-line" data-hero-line="left" aria-hidden="true" />
			<span class="mmz-blinds__hero-line" data-hero-line="right" aria-hidden="true" />

			<div class="mmz-blinds__hero-center">
				{occupation && (
					<p class="mmz-blinds__hero-occupation">{occupation}</p>
				)}
				<p class="mmz-blinds__hero-name">{displayName}</p>
				{bio && <p class="mmz-blinds__hero-bio">{bio}</p>}
			</div>

			{hasHeroAside && (
				<aside class="mmz-blinds__hero-side">
					{hero?.pillText && (
						<div class="mmz-blinds__hero-pill">{hero.pillText}</div>
					)}
					{(hero?.verticalTitle || hero?.verticalCreative) && (
						<div class="mmz-blinds__hero-vertical">
							{hero?.verticalTitle && (
								<span class="mmz-blinds__hero-v-title">
									{hero.verticalTitle}
								</span>
							)}
							{hero?.verticalName && (
								<span class="mmz-blinds__hero-v-sub">{hero.verticalName}</span>
							)}
							{hero?.verticalCreative && (
								<>
									<span class="mmz-blinds__hero-diamond" aria-hidden="true">
										✦
									</span>
									<span class="mmz-blinds__hero-v-sub">
										{hero.verticalCreative}
									</span>
								</>
							)}
						</div>
					)}
					{hero?.footerText && (
						<div class="mmz-blinds__hero-footer">
							<span class="mmz-blinds__hero-footer-line" aria-hidden="true" />
							<p class="mmz-blinds__hero-micro">{hero.footerText}</p>
						</div>
					)}
				</aside>
			)}

			{(hero?.speechChinese || hero?.speechEnglish) && (
				<div class="mmz-blinds__hero-speech">
					{hero?.speechChinese && (
						<p class="mmz-blinds__hero-speech-zh">{hero.speechChinese}</p>
					)}
					{hero?.speechEnglish && (
						<p class="mmz-blinds__hero-speech-en">{hero.speechEnglish}</p>
					)}
				</div>
			)}
		</div>

		<section
			class="mmz-blinds__reveal"
			data-blinds-reveal
			aria-label={i18n(I18nKey.mmzBlindsRevealAria)}
		>
			<div class="mmz-blinds__reveal-viewport"></div>
		</section>

		<section
			class="mmz-blinds__scenes"
			data-blinds-scenes
			aria-label={i18n(I18nKey.mmzBlindsScenesAria)}
		>
			<div class="mmz-blinds__scenes-viewport" data-scenes-viewport>
				<div
					class="mmz-blinds__cycle"
					style="--mmz-cycle-period:224px"
					aria-hidden="true"
					data-scenes-cycle
				>
					<div
						class="mmz-blinds__cycle-track"
						data-scenes-cycle-track
					></div>
				</div>

				<div
					class="mmz-blinds__bubbles"
					aria-hidden="true"
					data-scenes-bubbles
				>
					{
						Array.from({ length: 12 }).map(() => (
							<span class="mmz-blind-bubble" data-scene-bubble>
								<span class="mmz-blind-bubble__body" data-scene-bubble-body>
									<span
										class="mmz-blind-bubble__text"
										data-scene-bubble-text
									/>
									<img
										class="mmz-blind-bubble__image"
										data-scene-bubble-image
										alt=""
										loading="lazy"
										decoding="async"
									/>
								</span>
							</span>
						))
					}
				</div>

				<div class="mmz-blinds__track" data-scenes-track>
					{
						blindScenes.map((item) => (
							<BlindsScene
								index={item.index}
								item={item}
								composite={item.composite}
							/>
						))
					}
				</div>

				<div class="mmz-blinds__stands" data-scenes-stands aria-hidden="true">
					<div class="mmz-blinds__stands-track" data-scenes-stands-track>
						{
							standSrcs.map((src) => (
								<div class="mmz-blinds__stand" data-scenes-stand>
									<img
										class="mmz-blinds__stand-image"
										src={src}
										alt=""
										loading="lazy"
										decoding="async"
										draggable="false"
									/>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		{/* 终幕放大过渡层：最后一幕图框向满屏扩张，与收缩过渡层同一套几何、方向相反。
		    恒为 position: fixed，必须挂在根层级——被 pin 的场景 section 残留
		    transform 会让 fixed 退化成相对 section 定位。 */}
		<div class="mmz-blinds__finale" data-finale-portal aria-hidden="true">
			<img
				class="mmz-blinds__finale-image"
				src={blindSceneSrcs[blindSceneSrcs.length - 1]}
				alt=""
				loading="lazy"
				decoding="async"
				data-finale-image
			/>
		</div>

		<script
			type="application/json"
			data-blinds-config
			is:inline
			set:html={JSON.stringify(blindsRuntime)}
		/>
	</section>

	{/* 终幕衔接占位：把内容区压到一屏之外，让终幕文字显影期间屏幕上只有定格壁纸。
	    高度留给控制器按实测校准，避免硬编码视口单位。 */}
	<div class="mmz-finale-spacer" data-finale-spacer aria-hidden="true"></div>

	{/* 终幕文字层：独立 fixed 层，位于内容区之上。
	    「番茄主理人」信息组与「快速带你前往」同层同速上滑，
	    位置由控制器按内容区顶缘实测写入。 */}
	{(finaleTitle || finaleSubtitle) && (
		<div class="mmz-finale-copy" data-finale-copy-layer aria-hidden="true">
			<div class="mmz-finale-copy__inner" data-finale-copy-inner>
				{finaleTitle && (
					<h2 class="mmz-finale-copy__title">{finaleTitle}</h2>
